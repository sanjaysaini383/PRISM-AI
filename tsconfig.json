{
  "compilerOptions": {
    "incremental": false,
    "sourceMap": false,
    "allowJs": true,
    "checkJs": false,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "target": "ES2020",
    "module": "esnext",
    "outDir": "./lib",
    "rootDir": "./src",
    "strict": false,
    "noImplicitAny": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "allowSyntheticDefaultImports": true,
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "noEmit": true,
    "jsx": "preserve",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "src/**/*",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "dist",
    "lib",
    "node_modules",
    "**/*.test.ts",
    "src/bot.ts",
    "src/commenter.ts",
    "src/inputs.ts",
    "src/main.ts",
    "src/octokit.ts",
    "src/options.ts",
    "src/review-comment.ts",
    "src/review.ts",
    "src/tokenizer.ts",
    "src/fetch-polyfill.js",
    "src/limits.ts",
    "src/prompts.ts"
  ]
}
